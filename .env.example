APP_NAME=Bridge4U
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Workers that let php artisan serve answer requests in parallel. Linux and
# macOS only (4 is a good value there): PHP's built-in server can't fork on
# Windows, where it ignores this and answers one request at a time. For
# parallel requests on Windows serve public/ through XAMPP's Apache instead
# (docs/RUNNING.md, "Local speed")
PHP_CLI_SERVER_WORKERS=1

# Unset, debugbar is on with APP_ENV=local; false turns it off and makes each
# request cheaper
# DEBUGBAR_ENABLED=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bridge
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Idle seats: minutes without a heartbeat before tables:release-idle-seats
# (php artisan schedule:work) frees a player's seat, outside a set
BRIDGE_IDLE_SEAT_MINUTES=5

# Mid-set: seconds without a heartbeat before a player is marked away, and
# seconds the player on turn has to call or play before a robot takes their
# seat for the rest of the set (tables:check-away, every ten seconds under
# schedule:work)
BRIDGE_AWAY_SECONDS=60
BRIDGE_TURN_SECONDS=60

# Boards in a set: Start deals the first, the rest come by themselves, then
# Start again
BRIDGE_SET_SIZE=4

# Seconds a finished board stays on show before the set's next board is
# dealt (the DealNextBoard job, run by php artisan queue:work)
BRIDGE_NEXT_BOARD_SECONDS=15

# Seconds the last human a full table waits for has to press Start before
# their seat is freed (the ExpireStart job, run by php artisan queue:work)
BRIDGE_START_SECONDS=15

# Seconds to answer a claim before silence rejects it (the ExpireClaim job,
# run by php artisan queue:work)
BRIDGE_CLAIM_SECONDS=10

# The DDS double dummy solver library, loaded through PHP's FFI extension by
# php artisan queue:work (see docs/RUNNING.md), e.g. C:\dds\dds.dll or
# /usr/lib/x86_64-linux-gnu/libdds.so.0. Empty: no double dummy analysis
DDS_LIBRARY=

# Reverb (websockets): php artisan reverb:start. The app and the Reverb server
# read the same keys, so any values work locally; generate real ones for
# production (php artisan reverb:install)
REVERB_APP_ID=bridge
REVERB_APP_KEY=bridge-local-key
REVERB_APP_SECRET=bridge-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# The largest HTTP request (an event the app POSTs, headers included) Reverb
# accepts, in bytes. Reverb's own default, 10000, is hosted Pusher's limit
# too, which every event is kept under; the margin is so a payload that
# outgrows it still reaches the players locally
REVERB_MAX_REQUEST_SIZE=64000
